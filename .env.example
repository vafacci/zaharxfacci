# Populate locally only. Never commit real secrets.
DATABASE_URL="file:./dev.db"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Small model for RTX 2060 6GB (+ ComfyUI). Do not set 14B/32B defaults.
OLLAMA_MODEL="qwen2.5:3b"
# Small coder model for M3 developer tasks (do not set 14B/32B defaults)
OLLAMA_CODER_MODEL="qwen2.5-coder:3b"
# auto | ollama | demo  (demo is tests/offline only — never presented as live AI)
FACCI_PLANNER="auto"
HOST=127.0.0.1
PORT=3010
# No remote accounts, external credentials, publishing or paid providers configured by default.

# --- M4 integrations (optional; missing = honest not_connected / local staging) ---
IMAGE_STUDIO_BASE_URL="http://127.0.0.1:3000"
# Set to 0 to only prepare Image Studio payloads without queuing Comfy generation
IMAGE_STUDIO_EXECUTE="1"
POSTIZ_BASE_URL=""
POSTIZ_API_KEY=""
POSTIZ_INTEGRATION_ID=""
N8N_BASE_URL="http://127.0.0.1:5678"
N8N_API_KEY=""
# Live n8n triggers stay off even with API key (approval + this flag required later)
N8N_ALLOW_LIVE="0"

# --- M6 optional remote models (disabled by default; may incur third-party charges) ---
# Also require MonthlyBudget.remoteModelConsent=true and remoteModelMaxCalls > 0
FACCI_REMOTE_MODEL_CONSENT="0"
FACCI_REMOTE_MODEL_BASE_URL=""
FACCI_REMOTE_MODEL_API_KEY=""
FACCI_REMOTE_MODEL_ID=""
